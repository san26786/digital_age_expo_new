  updated_at                DateTime? @db.Timestamp(0)
  allDay                    Boolean   @default(true)
  color                     String    @db.VarChar(255)
  trigger_on                Int?
  event_phase_length        Int?
  description               String?
  page_summary              String?
  requirement               String?
  process                   String?
  why                       String?
